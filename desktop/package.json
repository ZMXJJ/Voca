{
  "name": "voca-desktop",
  "private": true,
  "version": "0.5.0",
  "scripts": {
    "dev:web": "npm --prefix app run dev",
    "build:web": "npm --prefix app run build",
    "lint:web": "npm --prefix app run lint",
    "typecheck:web": "npm --prefix app exec tsc -- -b",
    "prepare:dmg": "node ./scripts/prepare-dmg-resources.mjs",
    "prepare:windows": "node ./scripts/prepare-windows-resources.mjs",
    "prepare:linux": "node ./scripts/prepare-linux-resources.mjs",
    "prepare:linux:cpu": "VOCA_LINUX_ACCELERATOR=cpu node ./scripts/prepare-linux-resources.mjs",
    "prepare:linux:nvidia": "VOCA_LINUX_ACCELERATOR=nvidia node ./scripts/prepare-linux-resources.mjs",
    "tauri": "tauri",
    "dev": "node ./scripts/run-tauri-dev.mjs",
    "build": "node ./scripts/run-tauri-build.mjs",
    "build:dmg": "npm run prepare:dmg && node ./scripts/run-tauri-build.mjs --bundles dmg",
    "build:nsis": "npm run prepare:windows && node ./scripts/run-tauri-build.mjs --bundles nsis",
    "build:linux": "npm run prepare:linux && node ./scripts/run-tauri-build.mjs --bundles deb,appimage",
    "build:linux:cpu": "npm run prepare:linux:cpu && node ./scripts/run-tauri-build.mjs --bundles deb,appimage",
    "build:linux:nvidia": "npm run prepare:linux:nvidia && node ./scripts/run-tauri-build.mjs --bundles deb,appimage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
