{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Voca desktop skeleton.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "core:asset:default",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" }
      ]
    }
  ]
}
