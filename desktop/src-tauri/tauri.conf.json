{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voca",
  "version": "0.4.0",
  "identifier": "com.voca.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "beforeBuildCommand": "npm --prefix app run build",
    "frontendDist": "../app/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voca",
        "width": 1440,
        "height": 980,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [
      "../.bundle-resources/python-service",
      "../.bundle-resources/python-runtime",
      "../.bundle-resources/VoxCPM"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "wix": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
